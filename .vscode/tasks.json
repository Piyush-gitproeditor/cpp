{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "compile",
        "type": "shell",
        "command": "g++",
        "args": [
            "-std=c++17",
            "-o",
            "${fileBasenameNoExtension}",
            "${file}"
        ],
        "options": {
            "cwd": "${fileDirname}"
        },
        "group": {
            "kind": "build",
            "isDefault": false
        }
    },
    {
        "label": "compile and run",
        "type": "shell",
        "command": "powershell.exe",
        "args": [
            "-NoProfile",
            "-Command",
            "& { Set-Location -LiteralPath '${fileDirname}'; g++ -std=c++17 -o '${fileBasenameNoExtension}.exe' '${file}'; if ($LASTEXITCODE -eq 0) { Get-Content -LiteralPath 'input.txt' | & '.\\${fileBasenameNoExtension}.exe' | Set-Content -LiteralPath 'output.txt' } }"
        ],
        "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "close": true
        },
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
    {
        "type": "cmake",
        "label": "CMake: test",
        "command": "test",
        "problemMatcher": [],
        "detail": "CMake template test task"
    }
  ]
}
